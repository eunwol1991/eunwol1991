{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++ Runner: Debug Session",
      "type": "cppdbg",
      "request": "launch",
      "program": "c:/Users/User/puython/copypasterfile/build/Debug/outDebug.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "c:/Users/User/puython/copypasterfile",
      "externalConsole": true,

      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/mingw64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },

    {
      "name": "Streamlit: stock_datagrid.py",
      "type": "python",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/stock_datagrid.py"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },

    {
      "name": "Streamlit: Current File",
      "type": "python",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${file}"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ],

  "compounds": [
    {
      "name": "Run Streamlit + C/C++",
      "configurations": [
        "Streamlit: stock_datagrid.py",
        "C/C++ Runner: Debug Session"
      ]
    }
  ]
}
